# MH AI OS — Environment Variables Example
# ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# All AI API calls are server-side only. Keys are never exposed to the client.

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Database (Phase 39+) ──────────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (Phase 39+) ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Integrations (Phase 17+) ──────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ACCESS_TOKEN=

# ── Automation (Phase 18+) ────────────────────────────────────────────────────
# N8N_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=MH AI OS
NEXT_PUBLIC_APP_VERSION=0.2.0
NEXT_PUBLIC_DEMO_MODE=true
